#!/usr/bin/env bash
# Blocks a commit when the staged journal is behind the staged experiment files,
# or when an experiment ran or was called verified without a saved independent review.
# Installed with: git config core.hooksPath scripts/hooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
rc=0
python3 scripts/check_journal.py --staged || rc=1
python3 scripts/check_reviews.py --staged || rc=1
exit $rc
